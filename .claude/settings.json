{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/dev/agent-verify-hook session-start",
            "timeout": 10,
            "statusMessage": "Loading repository verification policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/dev/agent-verify-hook post-edit",
            "timeout": 600,
            "statusMessage": "Running fast repository verification"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/dev/agent-verify-hook stop",
            "timeout": 3600,
            "statusMessage": "Running required repository verification"
          }
        ]
      }
    ]
  }
}
