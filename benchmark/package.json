{
  "name": "stackhour-desktop-benchmark",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "fixture": "node scripts/generate-fixture.mjs",
    "build": "vite build && tauri build --no-bundle",
    "visual": "bash scripts/visual-tauri.sh",
    "bench": "dbus-run-session -- node scripts/run-tauri.mjs",
    "analyze": "node scripts/analyze.mjs",
    "manifest": "node scripts/machine-manifest.mjs"
  },
  "devDependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/cli": "2.11.4",
    "@vitejs/plugin-vue": "6.0.1",
    "vue": "3.5.18",
    "vue-tsc": "3.0.4",
    "vite": "7.0.6",
    "typescript": "5.9.3",
    "typescript-language-server": "5.0.0"
  },
  "pnpm": { "onlyBuiltDependencies": ["esbuild"] }
}
