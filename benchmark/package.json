{
  "name": "stackhour-desktop-benchmark",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "fixture": "node scripts/generate-fixture.mjs",
    "build": "cmake -S qt -B qt/build -DCMAKE_BUILD_TYPE=Release && cmake --build qt/build --config Release",
    "visual": "bash scripts/visual-qt.sh",
    "bench": "node scripts/run-qt.mjs",
    "analyze": "node scripts/analyze.mjs",
    "manifest": "node scripts/machine-manifest.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "6.0.0",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/cli": "2.11.4",
    "svelte": "5.35.6",
    "vite": "7.0.6",
    "typescript": "5.9.3",
    "typescript-language-server": "5.0.0"
  },
  "pnpm": { "onlyBuiltDependencies": ["esbuild"] }
}
