[Unit]
Description=Stackhour Telegram bridge coordinator for Claude Code and Codex
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/stackhour/bridge
ExecStart="/bin/true" bridge coordinator --runtime-dir "/home/stackhour/bridge"
Restart=always
RestartSec=5
UMask=0077
Environment="HOME=/home/stackhour"
Environment="PATH=/usr/local/bin:/usr/bin:/bin"

[Install]
WantedBy=default.target
